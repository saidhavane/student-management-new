pipeline {
    agent {
        label "worker"
    }
    stages {            
        stage('checkout'){
            steps {
                git branch: 'main', url: 'https://github.com/saidhavane/student-management-new.git'
            }
        }
        stage ('build') {
            steps{
                echo 'build success'
            }
        }
        stage ('test') {
            steps{
                echo 'test success'
            }
        }
        stage ('deploy'){
            steps{
                echo 'deploy success'
            }
        }
        }
    
}