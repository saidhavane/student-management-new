pipeline {
    agent {
        label "worker"
    }
    environment {
        my_aws_credentials = credentials('aws-access')
    }
    tools{
        maven "maven 3.9.5"
        
    }
    stages {            
        stage('checkout'){
            steps {
                git branch: 'main', url: 'https://github.com/saidhavane/student-management-new.git'
            }
        }
        stage ('build') {
            steps{
                sh '''
                mvn clean package
                echo 'build has been success'
                '''
            }

        }
    }
    
}