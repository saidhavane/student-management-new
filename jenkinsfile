pipeline {
    agent {
        label "worker"
    } 
    environment {
        my_aws_credentials = credentials('aws-access')
    }
    tools {
        maven "maven"
    }
    stages {
        stage ('checkout'){
            steps{
            git branch: 'main', url: 'https://github.com/saidhavane/student-management-new.git'
            sh '''
           echo "cloning is successfull"
           '''
        }
    }
    
    stage ("build"){
        steps {
            sh'''
            mvn clean package
            echo "build is successfull"
            '''
        }
        post {
            success{
                archiveArtifacts artifacts: 'target/*.war', fingerprint: true
            }
        }
     }
    }
}