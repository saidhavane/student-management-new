pipeline {
    agent {
        label "worker"
    }
    environment {
        my_aws_credentials = credentials('aws-access')
    }
    tools{
        maven "maven"
    }
    stages {            
        stage('checkout'){
            steps {
                git branch: 'main', url: 'https://github.com/saidhavane/student-management-new.git'
            }
        }
        stage ('build') {
            steps{
                sh '''
                mvn clean package
                echo 'build success'
                '''
            }
        
            post{
                success {
                    archiveArtifacts artifacts: '**target/*.war', fingerprint:true
                }
            }
        }
        stage ('artifact to s3'){
            steps{
                sh '''
                aws s3 cp target/*.war s3://mayurcbz.space2/Artifact/student.war
                '''
            }
        }
    }
    
}